<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    tools:context=".AddEditaIngredientActivity">

    <!--ingredient title-->
    <TextView
        android:id="@+id/addEditTitle"
        android:text="@string/add_edit_ingredient_title"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/dark_sage"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        />

    <!--Ingredient text field-->
    <EditText
        android:id="@+id/editIngredientName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/enter_ingredient"
        android:inputType="textCapSentences"
        android:autofillHints="none"
        android:minHeight="48dp"
        android:textColor="@color/dark_text"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/addEditTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"
        />

    <!--quantity text field-->
    <EditText
        android:id="@+id/editIngredientQuantity"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/enter_quantity_edit"
        android:inputType="numberDecimal"
        android:autofillHints="none"
        android:textColor="@color/dark_text"
        android:minHeight="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/editIngredientName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <!--unit text field-->
    <EditText
        android:id="@+id/editIngredientUnit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/enter_unit_edit"
        android:inputType="textCapSentences"
        android:autofillHints="none"
        android:textColor="@color/dark_text"
        android:minHeight="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/editIngredientQuantity"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <!--expiry text field-->
    <EditText
        android:id="@+id/editExpiryDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/enter_expiry_date"
        android:inputType="date"
        android:autofillHints="none"
        android:textColor="@color/dark_text"
        android:minHeight="48dp"
        app:layout_constraintTop_toBottomOf="@id/editIngredientUnit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <!-- save Ingredient Button -->
    <Button
        android:id="@+id/saveIngredientButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/save_ingredient"
        android:backgroundTint="@color/dark_sage"
        android:textColor="@color/white"
        android:minHeight="48dp"
        app:layout_constraintTop_toBottomOf="@id/editExpiryDate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp"
        />

    <!-- cancel Ingredient Button -->
    <Button
        android:id="@+id/cancelButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cancel"
        android:backgroundTint="@color/dark_sage"
        android:textColor="@color/white"
        android:minHeight="48dp"
        app:layout_constraintTop_toBottomOf="@id/saveIngredientButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="8dp"
        />

</androidx.constraintlayout.widget.ConstraintLayout>