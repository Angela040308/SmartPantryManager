<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    tools:context=".RecipeDetailActivity">

    <!--recipe ingredient-->
    <TextView
        android:id="@+id/recipeDetailTitle"
        android:text="@string/recipe_detail_name"
        android:textSize="24sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/dark_sage"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        />

    <!--recipe ingredient title-->
    <TextView
        android:id="@+id/ingredientTitle"
        android:text="@string/ingredients_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/dark_sage"
        app:layout_constraintTop_toBottomOf="@id/recipeDetailTitle"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        />

    <!--recipe ingredient title-->
    <TextView
        android:id="@+id/recipeIngredients"
        android:text="@string/ingredient_examples"
        android:textSize="16sp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/dark_text"
        app:layout_constraintTop_toBottomOf="@id/ingredientTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        />

    <!--Method title-->
    <TextView
        android:id="@+id/methodTitle"
        android:text="@string/method_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/dark_sage"
        app:layout_constraintTop_toBottomOf="@id/recipeIngredients"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        />

    <!--recipe method-->
    <TextView
        android:id="@+id/recipeMethod"
        android:text="@string/method_examples"
        android:textSize="16sp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/dark_text"
        app:layout_constraintTop_toBottomOf="@id/methodTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        />

</androidx.constraintlayout.widget.ConstraintLayout>