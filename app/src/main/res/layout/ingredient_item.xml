<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_white"
    android:padding="16dp"
    android:layout_margin="8dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:ignore="ExtraText">

    <TextView
        android:id="@+id/itemIngredientName"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:text="@string/ingredient_name_hint"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/dark_sage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <TextView
        android:id="@+id/itemingredientQuantity"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:text="@string/quantity_label"
        android:textColor="@color/dark_text"
        android:textSize="14sp"
        android:layout_marginTop="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/itemIngredientName"
        />

    <TextView
        android:id="@+id/itemingredientExpiryy"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:text="@string/expiry_date"
        android:textColor="@color/dark_text"
        android:textSize="14sp"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/itemingredientQuantity"
        />

    <Button
        android:id="@+id/deleteingredientButton"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:text="@string/delete_button"
        android:backgroundTint="@color/dark_sage"
        android:textColor="@color/white"
        android:minHeight="48dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/itemingredientExpiryy"
        />

    <Button
        android:id="@+id/editingredientButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/edit_button"
        android:backgroundTint="@color/dark_sage"
        android:textColor="@color/white"
        android:minHeight="48dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toEndOf="@id/deleteingredientButton"
        app:layout_constraintTop_toBottomOf="@id/itemingredientExpiryy" />

</androidx.constraintlayout.widget.ConstraintLayout>