<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    tools:context=".SettingsActivity">

    <!-- setting title-->
    <TextView
        android:id= "@+id/settingsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text= "@string/settings_title"
        android:textSize="24sp"
        android:textStyle= "bold"
        android:textColor="@color/dark_sage"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        />

    <!-- expiry alerts heading-->
    <TextView
        android:id= "@+id/expiryAlertsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text = "@string/expiry_alerts"
        android:textSize="18sp"
        android:textStyle= "bold"
        android:textColor="@color/dark_sage"
        app:layout_constraintTop_toBottomOf="@id/settingsTitle"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="32dp"
        android:layout_marginStart="16dp"
        />

    <!-- expiry alerts heading-->
    <TextView
        android:id= "@+id/expiryAlertsDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/expiry_alerts_description"
        android:textSize= "14sp"
        android:textColor="@color/dark_text"
        app:layout_constraintTop_toBottomOf="@id/expiryAlertsTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/expiryAlertsSwitch"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        />

    <!-- expiry alerts switch-->
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/expiryAlertsSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/expiry_alerts"
        app:layout_constraintTop_toTopOf="@id/expiryAlertsTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:thumbTint="@color/sage_green"
        app:trackTint="@color/light_sage"
        android:layout_marginEnd="16dp" />

    <!-- units preference heading-->
    <TextView
        android:id= "@+id/unitsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/preferred_units"
        android:textSize="18sp"
        android:textStyle= "bold"
        android:textColor="@color/dark_sage"
        app:layout_constraintTop_toBottomOf="@id/expiryAlertsDescription"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        />

    <!-- units preference description-->
    <TextView
        android:id= "@+id/unitsDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/preferred_units_description"
        android:textSize="14sp"
        android:textColor="@color/dark_text"
        app:layout_constraintTop_toBottomOf="@id/unitsTitle"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        />

    <!-- units dropdown-->
    <Spinner
        android:id= "@+id/unitsSpinner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/unitsDescription"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:minHeight="48dp"
        android:backgroundTint="@color/sage_green"
        android:padding="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        />


</androidx.constraintlayout.widget.ConstraintLayout>