<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    tools:context=".MainActivity">

    <!-- Pantry title -->
    <TextView
        android:id="@+id/pantryTitle"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:text="@string/app_title"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/dark_sage"
        android:gravity="center"
        android:contentDescription="@null"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Add ingredients title -->
    <TextView
        android:id="@+id/addIngredientsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_ingredient"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/dark_sage"
        android:layout_marginStart="18dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/ingredientName"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Ingredient name -->
    <EditText
        android:id="@+id/ingredientName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/enter_ingredient"
        android:inputType="textCapSentences"
        android:autofillHints="none"
        android:textColor="@color/dark_text"
        android:minHeight="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/pantryTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Quantity -->
    <EditText
        android:id="@+id/ingredientQuantity"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/enter_quantity"
        android:inputType="number"
        android:autofillHints="none"
        android:textColor="@color/dark_text"
        android:minHeight="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/ingredientName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Unit -->
    <EditText
        android:id="@+id/ingredientUnit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/enter_unit"
        android:inputType="textCapSentences"
        android:autofillHints="none"
        android:textColor="@color/dark_text"
        android:minHeight="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/ingredientQuantity"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Expiry date -->
    <EditText
        android:id="@+id/expiryDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/enter_expiry_date"
        android:inputType="date"
        android:autofillHints="none"
        android:textColor="@color/dark_text"
        android:minHeight="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/ingredientUnit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Add ingredient button -->
    <Button
        android:id="@+id/addIngredientButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_ingredient"
        android:backgroundTint="@color/dark_sage"
        android:textColor="@color/white"
        android:minHeight="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/expiryDate"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Clear button -->
    <Button
        android:id="@+id/clearButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/clear"
        android:backgroundTint="@color/dark_sage"
        android:textColor="@color/white"
        android:minHeight="48dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/addIngredientButton"
        app:layout_constraintTop_toTopOf="@id/addIngredientButton" />

    <!-- Suggested recipes button -->
    <Button
        android:id="@+id/suggestedRecipesButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Suggested Recipes"
        android:backgroundTint="@color/dark_sage"
        android:textColor="@color/white"
        android:minHeight="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/addIngredientButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/settingsButton" />

    <!-- Settings button -->
    <Button
        android:id="@+id/settingsButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:backgroundTint="@color/dark_sage"
        android:textColor="@color/white"
        android:minHeight="48dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toTopOf="@id/suggestedRecipesButton"
        app:layout_constraintStart_toEndOf="@id/suggestedRecipesButton"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Pantry list title -->
    <TextView
        android:id="@+id/pantryList"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/my_pantry"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/dark_sage"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/suggestedRecipesButton"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Pantry RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/pantryRecyclerview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/pantryList"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
